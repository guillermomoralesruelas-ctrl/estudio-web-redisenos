      "Bash(npm install)",
      "Bash(npm run *)",
      "Bash(npx vite *)",
      "Bash(node --no-warnings herramientas/db.mjs *)",
      "Bash(./db.cmd *)",
      "Bash(powershell -ExecutionPolicy Bypass -File herramientas/*)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git log *)",
      "Read(**)",
      "Edit(proyectos/**)",
      "Edit(cola/**)",
      "Edit(plantillas/**)",
      "Edit(herramientas/**)",
      "WebFetch"
